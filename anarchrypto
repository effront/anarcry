#!/bin/bash
DIR="$(dirname "$(realpath "$0")")"
SELF="$(realpath "$0")"

# Resolve version from build.gradle so the launcher never goes stale
VERSION=$(grep -oP "^version\s*=\s*'\K[^']+" "$DIR/build.gradle" 2>/dev/null || echo "")
JAR="$DIR/build/libs/anarcry-${VERSION}.jar"

# Auto-build: rebuild JAR if missing or source is newer
NEEDS_BUILD=false
if [ -z "$VERSION" ] || [ ! -f "$JAR" ]; then
    NEEDS_BUILD=true
elif [ -n "$(find "$DIR/src" -newer "$JAR" -name '*.java' -print -quit 2>/dev/null)" ]; then
    NEEDS_BUILD=true
fi

if [ "$NEEDS_BUILD" = true ]; then
    echo "AnarCry: building v${VERSION:-?} ..."
    (cd "$DIR" && ./gradlew shadowJar --quiet) || { echo "Build failed"; exit 1; }
fi

if [ ! -f "$JAR" ]; then
    echo "AnarCry: JAR nao encontrado apos build (v${VERSION:-?})"
    exit 1
fi

# Check if running in TUI mode (--tui flag present)
TUI_MODE=false
for arg in "$@"; do
    [ "$arg" = "--tui" ] && TUI_MODE=true
done

if [ "$TUI_MODE" = true ]; then
    # TUI mode: resize terminal if needed
    if [ -z "$_ANARCRY_READY" ]; then
        if command -v kitty &>/dev/null; then
            export _ANARCRY_READY=1
            exec kitty \
                --override initial_window_width=180c \
                --override initial_window_height=82c \
                --title "AnarCry v${VERSION}" \
                bash "$SELF" "$@"
        fi
        printf '\e[8;54;220t'
        if command -v xdotool &>/dev/null; then
            WID=$(xdotool getactivewindow 2>/dev/null)
            [ -n "$WID" ] && xdotool windowsize "$WID" 1660 1080 2>/dev/null
        fi
        sleep 0.4
        stty rows 54 cols 220 2>/dev/null
    fi
fi

exec java -jar "$JAR" "$@"
